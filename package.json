{
  "name": "ghe-metaverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Green Hydrogen Energy WebXR metaverse for ForgeX / Northstar LMS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
